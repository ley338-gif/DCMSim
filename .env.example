DCMSIM_DATABASE_URL=sqlite:////data/dcmsim.db
DCMSIM_CONNECT_TIMEOUT=5
DCMSIM_ASSOCIATION_TIMEOUT=10
DCMSIM_DIMSE_TIMEOUT=20
DCMSIM_MAX_UPLOAD_BYTES=52428800
DCMSIM_LOG_LEVEL=INFO
# Kliniknetz: Nur mit TLS-Proxy und lokal gebundenem Uvicorn aktivieren.
DCMSIM_PROXY_AUTH_ENABLED=false
DCMSIM_PROXY_AUTH_REQUIRED=false
DCMSIM_PROXY_USER_HEADER=X-Forwarded-User
DCMSIM_TRUSTED_PROXIES=127.0.0.1
# Native Installation: absoluter Pfad zum Vite-Build, z. B. /opt/dcmsim/current/apps/web/dist.
# Im Docker-Image ohne diesen Wert bleibt app/static aktiv.
# DCMSIM_STATIC_PATH=
# Docker Compose: 127.0.0.1 bleibt nur auf diesem Rechner erreichbar.
# Nur bei bewusst abgesichertem Netzwerkzugriff auf eine private Host-IP ändern.
DCMSIM_PUBLISH_HOST=127.0.0.1

