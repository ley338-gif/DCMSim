DCMSIM_DATABASE_URL=sqlite:////data/dcmsim.db
DCMSIM_CONNECT_TIMEOUT=5
DCMSIM_ASSOCIATION_TIMEOUT=10
DCMSIM_DIMSE_TIMEOUT=20
DCMSIM_MAX_UPLOAD_BYTES=52428800
DCMSIM_LOG_LEVEL=INFO
# Docker Compose: 127.0.0.1 bleibt nur auf diesem Rechner erreichbar.
# Nur bei bewusst abgesichertem Netzwerkzugriff auf eine private Host-IP ändern.
DCMSIM_PUBLISH_HOST=127.0.0.1

